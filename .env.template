# =============================================================================
#  .env.template  -  COMMITTED. Documents what the platform needs.
#  CONTAINS NO VALUES, and must never contain one.
# =============================================================================
#
#  Copy to .env and fill in. `.env` is gitignored (see .gitignore) and is the
#  ONLY place secrets live in this checkout. Nothing sensitive - no key, token,
#  password, client ID or account number - belongs in config.yaml, in a .md
#  file, or in any tracked source file. config.yaml references these by name
#  using ${VAR}; config_loader expands them at load time and RAISES if one is
#  missing, rather than substituting an empty string (see config_loader.py).
#
#      cp .env.template .env && $EDITOR .env
#      ./scripts/tp secrets check      # verify everything resolves
#      ./scripts/tp doctor             # full audit - run before any push
#
#  Optionally mirror .env into the macOS Keychain, encrypted at rest:
#      ./scripts/tp secrets import .env
#  storage/secrets.py resolves in this order: environment -> .env -> Keychain.
#
# -----------------------------------------------------------------------------
#  REQUIRED - brokerage
# -----------------------------------------------------------------------------
# Used by mcp_clients/robinhood_mcp.py (read-only account data: positions, cost
# basis, portfolio value) and engine/live_trader.py (direct order execution -
# only reachable when all three live-execution gates in config.yaml are open,
# which as of v1.0.0 they deliberately are not). Leave blank to disable.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# ONLY if you log in with an authenticator app. Base32 seed (A-Z, 2-7) from
# Account -> Security -> Two-Factor Authentication. Face ID / push users: blank.
ROBINHOOD_TOTP_SECRET=
# The account designated for agent trading. Was a literal in the versioned
# config.yaml until Phase 0 step 0.2. Keep this account separately funded -
# the isolation is only real if it is not a sub-account of your main holdings.
RH_ACCOUNT_NUMBER=

# -----------------------------------------------------------------------------
#  REQUIRED - web UI
# -----------------------------------------------------------------------------
# 32+ chars. Generate with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# An empty value would compare equal to a blank Authorization header and
# unauthenticate every write endpoint, so config_loader refuses to default it.
UI_AUTH_TOKEN=
# Loopback only. Never bind 0.0.0.0 - see §4.
TP_UI_HOST=127.0.0.1
TP_UI_PORT=8080

# -----------------------------------------------------------------------------
#  DATABASE  (per-version: scripts/tp sets POSTGRES_DB when running a version)
# -----------------------------------------------------------------------------
# Defaults suit a local `brew install postgresql` with trust auth and a
# `trading_platform` database created via migrate_to_postgres.py. Only set
# USER/PASSWORD if your Postgres differs.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_platform
POSTGRES_USER=
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
#  MARKET DATA  (all optional - each provider activates only when its key is
#  present; with none set, yfinance stays primary as before)
# -----------------------------------------------------------------------------
# Alpaca (https://alpaca.markets - free, real-time IEX): PRIMARY quotes + bars
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Finnhub (https://finnhub.io - free 60 calls/min): quote backup + company news
FINNHUB_API_KEY=
# Tiingo (https://tiingo.com - free tier): EOD bars fallback + IEX quote backup
TIINGO_API_KEY=
# Twelve Data (https://twelvedata.com - free 8 credits/min): last-resort fallback
TWELVEDATA_API_KEY=
# Alpha Vantage (https://www.alphavantage.co - free ~25 req/day): movers
# discovery + full US symbol listing for the universe sweep. The platform
# hard-caps itself at 20 AV calls/day; too rate-limited for per-ticker data.
ALPHAVANTAGE_API_KEY=
# Financial Modeling Prep (https://financialmodelingprep.com - free ~250/day):
# movers discovery + full stock list + company-profile fallback. Capped at 200/day.
FMP_API_KEY=

# -----------------------------------------------------------------------------
#  KEYLESS / MCP ENDPOINTS
# -----------------------------------------------------------------------------
# SEC EDGAR (mcp_clients/edgar_data.py) - insider Form 4 filings, no key or
# account needed. SEC's fair-access policy asks for a descriptive contact
# string identifying the requester. Not a secret, but it is personal data, so
# it lives here rather than in a tracked file. Format: "Name your@email.com"
EDGAR_USER_AGENT=
# Trayd hosted MCP (mcp_clients/trayd_mcp.py) - full order execution, unlike
# the read-only robinhood-mcp. Link your account at https://mcp.trayd.ai first,
# then set the URL below to activate. See docs/trayd.md.
TRAYD_MCP_URL=
# Only if trayd starts requiring one.
TRAYD_AUTH_TOKEN=
# defeatbeta-api (mcp_clients/defeatbeta_data.py) needs no variable at all -
# `pip install defeatbeta-api` activates it, otherwise it stays fully inert.

# -----------------------------------------------------------------------------
#  SUPERSEDED - engine/claude_brain.py's NVIDIA NIM fallback is no longer in
#  the active pipeline. Listed only so a stale value in an old .env is
#  accounted for. The key previously held here was exposed in a chat window
#  and must be REVOKED, not reused.
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=

# -----------------------------------------------------------------------------
#  RUNTIME SWITCHES  (not secrets; normally set by scripts/tp - listed here so
#  the full set of externally-configurable values is documented in one place)
# -----------------------------------------------------------------------------
# TP_OUTPUT_DIR              per-version runtime data root (storage/paths.py, §38.2)
# TP_FORCE_PAPER=1           hard veto on live execution regardless of config (§38.4)
# TP_VERSION                 the tag this process is running (stamped onto rows)
# TP_REQUIRE_REFERENCE_TA=1  refuse to start without pandas_ta (§13) - default on
# TP_ENV_FILE                override the path to this file
