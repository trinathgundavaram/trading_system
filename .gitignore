# =============================================================================
#  Phase 0 step 0.3 (§34.2). Ignore rules go in FIRST, before a single file is
#  staged. Doing it the other way round is how secrets get into a first commit.
# =============================================================================

# ── Secrets: never, under any circumstances ─────────────────────────────────
.env
.env.*
!.env.template
*.pem
*.p12
*.pfx
*.key
tokens/
.tokens/
*.pickle
secrets.local.*
credentials.json
service-account*.json

# ── Local runtime data: machine-specific, often large, never shared ─────────
# output/ currently holds 344 MB of logs, prompts, backtest artefacts and
# database files. None of it belongs in git; all of it is reproducible or
# archivable separately (§30, and `tp backup` in §39.2).
output/
!output/.gitkeep
*.db
*.db-wal
*.db-shm
*.db.bak-*
*.postgres-backup-*
# Database DUMPS - a dump holds positions, account activity and the entire
# signal history. It is more sensitive than the code and must never reach a
# remote. Schema MIGRATIONS are the opposite: they are source, and a version
# that cannot recreate its own schema is not reproducible.
*.sql
!migrations/*.sql
*.sql.gz
*.sql.gz.sha256

# ── Reports and generated documents ────────────────────────────────────────
# The evaluation and remediation reports quote config.yaml verbatim, which as
# of the pre-remediation tree included the Robinhood account number and the UI
# auth token. A .docx is a zip - a scanner reading the repo as text sees
# nothing, so this must be excluded by path, not by content scan. These
# documents are deliverables, not source: keep them locally, back them up with
# `tp backup`, but do not put them in a git remote.
*.docx
*.doc
*.pdf
*.pptx
*.xlsx

# ── Version-manager scratch (§38) ──────────────────────────────────────────
.tp/
venv/
.venv/
env/
VERSION.local

# ── Build / editor / OS noise ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/
node_modules/
.DS_Store
.idea/
.vscode/
*.swp
*~

# ── Phase 3 (§42, §45) runtime artefacts ───────────────────────────────────
# .env.runtime is already covered by the `.env.*` rule at the top of this
# file, and that is the important one: it is a materialised copy of every
# secret, written 0600 for `docker compose` and deleted as soon as the
# containers are up (§44, scripts/tp_agent.py).
#
# _run_<service>.bat is generated by scripts/services.py's Windows backend,
# because schtasks cannot express environment variables. It contains the
# service environment - including anything exported into it - so it is local
# by nature and must not be committed.
_run_*.bat
